# Chave da API (nível gratuito do Gemini, Google AI Studio)
# Crie grátis em: https://aistudio.google.com/apikey
CUA_API_KEY=COLE_SUA_CHAVE_AQUI

# Opcional: Groq (chave grátis em https://console.groq.com/keys)
# CUA_GROQ_API_KEY=

# Opcionais (descomente para sobrescrever os padrões)
# CUA_MODEL=gemini-3.5-flash-lite
# CUA_MAX_STEPS=30
# CUA_AUTO_APPROVE=1
CUA_MONITOR=1
